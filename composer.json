{
    "name": "sistema-estudantes/academico",
    "description": "Sistema web simples de cadastro academico em PHP puro com MongoDB",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1",
        "ext-mongodb": "*",
        "mongodb/mongodb": "^1.19 || ^2.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        },
        "files": [
            "src/helpers.php",
            "config/database.php"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
